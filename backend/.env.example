# Copy this file to .env and replace every placeholder value.
# Never commit the real .env file.

NODE_ENV=development
PORT=5000

# Allowed browser origin for the React dev server
CLIENT_ORIGIN=http://localhost:5173

# MySQL / MariaDB connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=gym_ms

# JWT secret: use a long random string, e.g. generate with
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=8h

# bcrypt cost factor (10-12 recommended)
BCRYPT_ROUNDS=12

# Optional: password used for the sample/demo accounts created by `npm run seed`.
# If omitted, a random password is generated and printed once in the console.
SEED_DEMO_PASSWORD=

